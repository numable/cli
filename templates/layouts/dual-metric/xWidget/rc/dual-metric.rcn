                "fontSize": "6pt"
              },
              {
                "text": "$[findNotEmpty::(${aUnit},)]",
                "fontSize": "11pt",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${aS},__none__),__none__),0,if::(eq::(${aS},--),0,if::(gt::(findNotEmpty::(${aL},0),9),1,0)))]"
        },
        "react": [
          {
            "id": "av2",
