{
  "_note": "版式「双指标」· 42 档(338×158)。坐标与配色是版式的一部分,不要改;要换内容改 flow/dual-metric.df 的「① 槽位」。由版式生成器产出。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "{parent.w}-{at.w}-14pt",
        "y": "15pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${at},)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "_note": "时效锚(右上):取数时刻。槽位 at 为空时宽度为 0,组件名自动占满。"
      },
      {
        "type": "txt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "textColor": "#0E1116|#F3F4F6",
        "id": "nm",
        "x": "23pt",
        "y": "12pt",
        "w": "{at.x}-29pt",
        "text": "$[findNotEmpty::(${title},--)]",
        "fontSize": "13pt",
        "typeface": "System-Bold"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "14pt",
        "y": "{nm.y}+({nm.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "$[if::(eq::(${accent},green),#2E9E6B|#45C793,if::(eq::(${accent},blue),#2F6FE4|#5C9BFF,if::(eq::(${accent},purple),#7A5AF8|#A78BFA,if::(eq::(${accent},orange),#E07B39|#F0A05F,if::(eq::(${accent},rose),#D2536D|#E87A93,if::(eq::(${accent},teal),#0E9AA7|#35C2CE,if::(eq::(${accent},graphite),#8A9099|#6E747D,#5B5BD6|#A5A3FF)))))))]",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "ta",
        "type": "layer",
        "x": "14pt",
        "y": "38pt",
        "w": "151pt",
        "h": "106pt",
        "bgColor": "#E7E9EE|#20232A",
        "cornerRadius": {
          "leftT": "12pt",
          "leftB": "12pt",
          "rightT": "12pt",
          "rightB": "12pt"
        }
      },
      {
        "type": "txt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "textColor": "#6B7280|#8E939B",
        "id": "al",
        "x": "24pt",
        "y": "48pt",
        "w": "131pt",
        "text": "$[findNotEmpty::(${aLabel},--)]",
        "fontSize": "11pt"
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${aS},__none__),__none__),0,if::(eq::(${aS},--),0,if::(le::(findNotEmpty::(${aL},0),7),1,0)))]"
        },
        "react": [
          {
            "id": "av0",
            "type": "richText",
            "x": "24pt",
            "y": "74.25pt",
            "w": "131pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "${aS}",
                "fontSize": "30pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "8pt"
              },
              {
                "text": "$[findNotEmpty::(${aUnit},)]",
                "fontSize": "11pt",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${aS},__none__),__none__),0,if::(eq::(${aS},--),0,if::(and::(gt::(findNotEmpty::(${aL},0),7),le::(findNotEmpty::(${aL},0),9)),1,0)))]"
        },
        "react": [
          {
            "id": "av1",
            "type": "richText",
            "x": "24pt",
            "y": "78.6pt",
            "w": "131pt",
            "h": "-1",
