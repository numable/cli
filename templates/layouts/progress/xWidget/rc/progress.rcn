{
  "_note": "版式「进度」· 22 档(158×158)。坐标与配色是版式的一部分,不要改;要换内容改 flow/progress.df 的「① 槽位」。由版式生成器产出。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "{parent.w}-{at.w}-12pt",
        "y": "14pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${at},)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "_note": "时效锚(右上):取数时刻。槽位 at 为空时宽度为 0,组件名自动占满。"
      },
      {
        "type": "txt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "textColor": "#0E1116|#F3F4F6",
        "id": "nm",
        "x": "21pt",
        "y": "11pt",
        "w": "{at.x}-27pt",
        "text": "$[findNotEmpty::(${title},--)]",
        "fontSize": "13pt",
        "typeface": "System-Bold"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "12pt",
        "y": "{nm.y}+({nm.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "$[if::(eq::(${accent},green),#2E9E6B|#45C793,if::(eq::(${accent},blue),#2F6FE4|#5C9BFF,if::(eq::(${accent},purple),#7A5AF8|#A78BFA,if::(eq::(${accent},orange),#E07B39|#F0A05F,if::(eq::(${accent},rose),#D2536D|#E87A93,if::(eq::(${accent},teal),#0E9AA7|#35C2CE,if::(eq::(${accent},graphite),#8A9099|#6E747D,#5B5BD6|#A5A3FF)))))))]",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "id": "trk",
        "type": "arc",
        "x": "41pt",
        "y": "36pt",
        "w": "76pt",
        "h": "76pt",
        "startAngle": "-90",
        "sweepAngle": "360",
        "useCenter": "0",
        "lineWidth": "9pt",
        "strokeColor": "#E7E9EE|#20232A"
      },
      {
        "id": "arc",
        "type": "arc",
        "x": "41pt",
        "y": "36pt",
        "w": "76pt",
        "h": "76pt",
        "startAngle": "-90",
        "sweepAngle": "$[findNotEmpty::(${sweep},0)]",
        "useCenter": "0",
        "lineWidth": "9pt",
        "lineCap": "round",
        "strokeColor": "$[if::(eq::(${accent},green),#2E9E6B|#45C793,if::(eq::(${accent},blue),#2F6FE4|#5C9BFF,if::(eq::(${accent},purple),#7A5AF8|#A78BFA,if::(eq::(${accent},orange),#E07B39|#F0A05F,if::(eq::(${accent},rose),#D2536D|#E87A93,if::(eq::(${accent},teal),#0E9AA7|#35C2CE,if::(eq::(${accent},graphite),#8A9099|#6E747D,#5B5BD6|#A5A3FF)))))))]",
        "hide": "$[if::(eq::(${hasR},1),0,1)]"
      },
      {
        "type": "txt",
        "h": "76pt",
        "maxLines": "1",
        "lineBreak": "0",
        "textColor": "#0E1116|#F3F4F6",
        "id": "pct",
        "x": "41pt",
        "y": "36pt",
        "w": "76pt",
        "alignmentH": "1",
        "alignmentV": "1",
        "text": "$[findNotEmpty::(${pctS},--)]",
        "fontSize": "18pt",
        "typeface": "System-Bold"
      },
      {
        "type": "txt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "textColor": "#6B7280|#8E939B",
        "id": "cnt",
        "x": "12pt",
        "y": "124pt",
        "w": "134pt",
        "alignmentH": "1",
        "text": "$[findNotEmpty::(${doneS},--)] / $[findNotEmpty::(${totalS},--)] $[findNotEmpty::(${unit},)]",
        "fontSize": "11pt"
      }
    ]
  }
}
