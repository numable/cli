{
  "version": 2,
  "title": "大数字",
  "sub": "版式 · 2×2",
  "i18n": {
    "en-US": {
      "title": "Big number",
      "sub": "Layout · 2×2"
    }
  },
  "layout": 22,
  "params": {},
