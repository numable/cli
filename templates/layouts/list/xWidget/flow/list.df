        "value": "$[if::(startsWith::(${@app.language},zh),if::(ge::(${_v1A},100000000),亿,if::(ge::(${_v1A},10000),万,)),if::(ge::(${_v1A},1000000000),B,if::(ge::(${_v1A},1000000),M,if::(ge::(${_v1A},1000),K,))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "v1C",
        "value": "$[if::(eq::(findNotEmpty::(${_v1V},__none__),__none__),--,if::(matches::(${_v1V},^-?\\[0-9.\\]+$),${_v1K}${_v1U},${_v1O}))]"
      },
      "_note": "紧凑写法(小档用)"
    },
    {
      "op": "set",
      "props": {
        "key": "v1",
        "value": "$[if::(eq::(findNotEmpty::(${_v1V},__none__),__none__),--,if::(eq::(${format},raw),${_v1O},if::(matches::(${_v1V},^-?\\[0-9.\\]+$),if::(eq::(${format},int),parseNumber::(round::(${_v1V}),#\\,##0),if::(eq::(${format},1dp),parseNumber::(${_v1V},#\\,##0.0),if::(eq::(${format},2dp),parseNumber::(${_v1V},#\\,##0.00),if::(eq::(${format},compact),${v1C},parseNumber::(${_v1V},#\\,##0.##))))),${_v1O})))]"
      },
      "_note": "显示串:按 format 格式化;不是数字时原样显示;取不到 = --"
    },
    {
      "op": "set",
      "props": {
        "key": "h1",
