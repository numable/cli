        "key": "_v1A",
        "value": "$[if::(lt::(${_v1V},0),calc::(0-${_v1V}),${_v1V})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_v1K",
        "value": "$[if::(startsWith::(${@app.language},zh),if::(ge::(${_v1A},100000000),parseNumber::(calc::(${_v1V}/100000000),0.##),if::(ge::(${_v1A},10000),parseNumber::(calc::(${_v1V}/10000),0.#),parseNumber::(${_v1V},0.#))),if::(ge::(${_v1A},1000000000),parseNumber::(calc::(${_v1V}/1000000000),0.##),if::(ge::(${_v1A},1000000),parseNumber::(calc::(${_v1V}/1000000),0.##),if::(ge::(${_v1A},1000),parseNumber::(calc::(${_v1V}/1000),0.#),parseNumber::(${_v1V},0.#)))))]"
      }
    },
