      "props": {
        "key": "v4",
        "value": "$[if::(eq::(findNotEmpty::(${_v4V},__none__),__none__),--,if::(eq::(${format},raw),${_v4O},if::(matches::(${_v4V},^-?\\[0-9.\\]+$),if::(eq::(${format},int),parseNumber::(round::(${_v4V}),#\\,##0),if::(eq::(${format},1dp),parseNumber::(${_v4V},#\\,##0.0),if::(eq::(${format},2dp),parseNumber::(${_v4V},#\\,##0.00),if::(eq::(${format},compact),${v4C},parseNumber::(${_v4V},#\\,##0.##))))),${_v4O})))]"
      },
      "_note": "显示串:按 format 格式化;不是数字时原样显示;取不到 = --"
    },
    {
      "op": "set",
      "props": {
        "key": "h4",
        "value": "$[if::(eq::(findNotEmpty::(${n4},__none__),__none__),0,1)]"
      },
      "_note": "第 5 行有没有内容"
    },
    {
      "action": "resultFilter",
      "params": {
        "keys": [
          "title",
          "at",
          "accent",
          "empty",
          "count",
          "n0",
          "s0",
          "v0",
          "h0",
          "n1",
          "s1",
          "v1",
          "h1",
          "n2",
          "s2",
          "v2",
          "h2",
          "n3",
          "s3",
          "v3",
          "h3",
          "n4",
          "s4",
          "v4",
          "h4"
        ]
      }
    }
  ]
}
