{
  "version": 1,
  "_note": "版式「排行」的取数流。① 槽位:每个槽一条 op:set,把示例值换成你的取数表达式或文案(说明见 slots.json);要联网就在 ① 之前加 request 与屏障,并把 host 写进 manifest.network。② 派生:固定,不要改 —— 组件上的坐标、配色、格式化都靠它。i18n 里 t_ 开头的是版式自带文案。",
  "i18n": {
    "zh-CN": {
      "title": "本月支出",
      "names0": "餐饮",
      "names1": "房租",
      "names2": "交通",
      "names3": "购物",
      "names4": "娱乐",
      "subs0": "40%",
      "subs1": "34%",
      "subs2": "11%",
      "subs3": "9%",
      "subs4": "5%"
    },
    "en-US": {
      "title": "Spending this month",
      "names0": "Dining",
      "names1": "Rent",
      "names2": "Transport",
      "names3": "Shopping",
      "names4": "Fun",
      "subs0": "40%",
      "subs1": "34%",
      "subs2": "11%",
      "subs3": "9%",
      "subs4": "5%"
    }
  },
  "actions": [
    {
      "op": "set",
      "props": {
        "key": "_slots",
        "value": "1"
      },
      "_note": "────── ① 槽位(只改这一段) ──────"
    },
    {
      "op": "set",
      "props": {
        "key": "title",
        "value": "${@i18n.title}"
      },
      "_note": "槽位 title(text,必填):组件名(第一行):有对象写对象名,没有就写功能名"
    },
    {
      "op": "set",
      "props": {
        "key": "names",
        "value": [
          "${@i18n.names0}",
          "${@i18n.names1}",
          "${@i18n.names2}",
          "${@i18n.names3}",
          "${@i18n.names4}"
        ]
      },
      "_note": "槽位 names(text[],必填):按名次排好的名字(数组,第一个 = 第 1 名)"
    },
    {
      "op": "set",
      "props": {
        "key": "values",
        "value": [
          "3260",
          "2800",
          "940",
          "720",
          "410"
        ]
      },
      "_note": "槽位 values(number[],必填):对应的数(数组);长度条按它和第一名的比例画"
    },
    {
      "op": "set",
      "props": {
        "key": "format",
        "value": "auto"
      },
      "_note": "槽位 format(enum):数字格式:auto 千分位 + 最多两位小数 · int 取整 · 1dp / 2dp 固定小数 · compact 中文万 / 亿、英文 K / M / B · raw 原样显示"
    },
    {
      "op": "set",
      "props": {
        "key": "subs",
        "value": [
          "${@i18n.subs0}",
          "${@i18n.subs1}",
          "${@i18n.subs2}",
          "${@i18n.subs3}",
          "${@i18n.subs4}"
        ]
      },
      "_note": "槽位 subs(text[]):每行右下一句(数组,只在 44 档显示):占比、变化"
    },
    {
      "op": "set",
      "props": {
        "key": "at",
        "value": "$[formatDate::(${@time.nowMs},HH:mm)]"
      },
      "_note": "槽位 at(time):时效锚(右上角):数据是什么时候取到的,当天 HH:mm、跨天 MM-dd HH:mm;纯本地计算的组件留空"
    },
    {
      "op": "set",
      "props": {
        "key": "accent",
        "value": "orange"
      },
      "_note": "槽位 accent(enum):源色:身份点与强调色。只选名字;财经涨跌类用 graphite(红绿已被涨跌占用)"
    },
    {
      "op": "set",
      "props": {
        "key": "_derived",
        "value": "1"
      },
      "_note": "────── ② 派生(固定,不要改) ──────"
    },
    {
      "op": "set",
      "props": {
        "key": "accent",
        "value": "$[findNotEmpty::(${accent},indigo)]"
      },
      "_note": "源色名兜底"
    },
    {
      "op": "set",
      "props": {
        "key": "count",
        "value": "$[length::(findNotEmpty::(${names},))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "n0",
        "value": "$[findNotEmpty::(index::(${names},0),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "s0",
        "value": "$[findNotEmpty::(index::(${subs},0),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_v0O",
        "value": "$[findNotEmpty::(index::(${values},0),)]"
      },
      "_note": "原值(raw / 非数字时原样显示)"
    },
    {
      "op": "set",
      "props": {
        "key": "_v0V",
        "value": "$[replaceAll::(${_v0O},\\,,)]"
      },
      "_note": "去掉千分位逗号后的数字"
    },
    {
      "op": "set",
      "props": {
        "key": "_v0A",
        "value": "$[if::(lt::(${_v0V},0),calc::(0-${_v0V}),${_v0V})]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_v0K",
        "value": "$[if::(startsWith::(${@app.language},zh),if::(ge::(${_v0A},100000000),parseNumber::(calc::(${_v0V}/100000000),0.##),if::(ge::(${_v0A},10000),parseNumber::(calc::(${_v0V}/10000),0.#),parseNumber::(${_v0V},0.#))),if::(ge::(${_v0A},1000000000),parseNumber::(calc::(${_v0V}/1000000000),0.##),if::(ge::(${_v0A},1000000),parseNumber::(calc::(${_v0V}/1000000),0.##),if::(ge::(${_v0A},1000),parseNumber::(calc::(${_v0V}/1000),0.#),parseNumber::(${_v0V},0.#)))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_v0U",
        "value": "$[if::(startsWith::(${@app.language},zh),if::(ge::(${_v0A},100000000),亿,if::(ge::(${_v0A},10000),万,)),if::(ge::(${_v0A},1000000000),B,if::(ge::(${_v0A},1000000),M,if::(ge::(${_v0A},1000),K,))))]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "v0C",
        "value": "$[if::(eq::(findNotEmpty::(${_v0V},__none__),__none__),--,if::(matches::(${_v0V},^-?\\[0-9.\\]+$),${_v0K}${_v0U},${_v0O}))]"
      },
      "_note": "紧凑写法(小档用)"
    },
    {
      "op": "set",
      "props": {
        "key": "v0",
        "value": "$[if::(eq::(findNotEmpty::(${_v0V},__none__),__none__),--,if::(eq::(${format},raw),${_v0O},if::(matches::(${_v0V},^-?\\[0-9.\\]+$),if::(eq::(${format},int),parseNumber::(round::(${_v0V}),#\\,##0),if::(eq::(${format},1dp),parseNumber::(${_v0V},#\\,##0.0),if::(eq::(${format},2dp),parseNumber::(${_v0V},#\\,##0.00),if::(eq::(${format},compact),${v0C},parseNumber::(${_v0V},#\\,##0.##))))),${_v0O})))]"
      },
      "_note": "显示串:按 format 格式化;不是数字时原样显示;取不到 = --"
    },
    {
      "op": "set",
      "props": {
        "key": "h0",
        "value": "$[if::(eq::(findNotEmpty::(${n0},__none__),__none__),0,1)]"
      },
      "_note": "第 1 行有没有内容"
    },
    {
      "op": "set",
      "props": {
        "key": "n1",
        "value": "$[findNotEmpty::(index::(${names},1),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "s1",
        "value": "$[findNotEmpty::(index::(${subs},1),)]"
      }
    },
    {
      "op": "set",
      "props": {
        "key": "_v1O",
        "value": "$[findNotEmpty::(index::(${values},1),)]"
      },
      "_note": "原值(raw / 非数字时原样显示)"
    },
    {
      "op": "set",
      "props": {
        "key": "_v1V",
        "value": "$[replaceAll::(${_v1O},\\,,)]"
