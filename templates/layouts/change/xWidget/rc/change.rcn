{
  "_note": "版式「涨跌」· 22 档(158×158)。坐标与配色是版式的一部分,不要改;要换内容改 flow/change.df 的「① 槽位」。由版式生成器产出。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "id": "at",
        "type": "txt",
        "x": "{parent.w}-{at.w}-12pt",
        "y": "14pt",
        "w": "-1",
        "h": "-1",
        "maxLines": "1",
        "text": "$[findNotEmpty::(${at},)]",
        "fontSize": "9pt",
        "textColor": "#6B7280|#8E939B",
        "_note": "时效锚(右上):取数时刻。槽位 at 为空时宽度为 0,组件名自动占满。"
      },
      {
        "type": "txt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "textColor": "#0E1116|#F3F4F6",
        "id": "nm",
        "x": "21pt",
        "y": "11pt",
        "w": "{at.x}-27pt",
        "text": "$[findNotEmpty::(${title},--)]",
        "fontSize": "13pt",
        "typeface": "System-Bold"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "12pt",
        "y": "{nm.y}+({nm.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "$[if::(eq::(${accent},green),#2E9E6B|#45C793,if::(eq::(${accent},blue),#2F6FE4|#5C9BFF,if::(eq::(${accent},purple),#7A5AF8|#A78BFA,if::(eq::(${accent},orange),#E07B39|#F0A05F,if::(eq::(${accent},rose),#D2536D|#E87A93,if::(eq::(${accent},teal),#0E9AA7|#35C2CE,if::(eq::(${accent},graphite),#8A9099|#6E747D,#5B5BD6|#A5A3FF)))))))]",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${priceS},__none__),__none__),0,if::(eq::(${priceS},--),0,if::(le::(findNotEmpty::(${priceL},0),6),1,0)))]"
        },
        "react": [
          {
            "id": "px0",
            "type": "richText",
            "x": "12pt",
            "y": "41.9pt",
            "w": "134pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "${priceS}",
                "fontSize": "36pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${priceS},__none__),__none__),0,if::(eq::(${priceS},--),0,if::(and::(gt::(findNotEmpty::(${priceL},0),6),le::(findNotEmpty::(${priceL},0),8)),1,0)))]"
        },
        "react": [
          {
            "id": "px1",
            "type": "richText",
            "x": "12pt",
            "y": "46.25pt",
            "w": "134pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "${priceS}",
                "fontSize": "30pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${priceS},__none__),__none__),0,if::(eq::(${priceS},--),0,if::(and::(gt::(findNotEmpty::(${priceL},0),8),le::(findNotEmpty::(${priceL},0),10)),1,0)))]"
        },
        "react": [
          {
            "id": "px2",
            "type": "richText",
            "x": "12pt",
            "y": "49.88pt",
            "w": "134pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "${priceS}",
                "fontSize": "25pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${priceS},__none__),__none__),0,if::(eq::(${priceS},--),0,if::(gt::(findNotEmpty::(${priceL},0),10),1,0)))]"
        },
        "react": [
          {
            "id": "px3",
            "type": "richText",
            "x": "12pt",
            "y": "53.5pt",
            "w": "134pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "${priceS}",
                "fontSize": "20pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(findNotEmpty::(${priceS},__none__),__none__),1,if::(eq::(${priceS},--),1,0))]"
        },
        "react": [
          {
            "id": "pxE",
            "type": "richText",
            "x": "12pt",
            "y": "52.7pt",
            "w": "134pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "--",
                "fontSize": "36pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              }
            ]
          }
        ],
        "_note": "取不到值:单独画「--」,压到数字墨迹中线"
      },
      {
        "type": "txt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "textColor": "$[if::(eq::(${chgTone},1),#FF5C4D|#FF5C4D,if::(eq::(${chgTone},2),#1FC77D|#1FC77D,if::(eq::(${chgTone},3),#9AA0A6|#8E939B,#9AA0A6|#8E939B)))]",
        "id": "pill",
        "x": "12pt",
        "y": "80pt",
        "w": "-1",
        "text": "$[findNotEmpty::(${chgS},--)]",
        "fontSize": "13pt",
        "typeface": "System-Bold",
        "bgColor": "$[if::(eq::(${chgTone},1),#15FF5C4D|#15FF5C4D,if::(eq::(${chgTone},2),#151FC77D|#151FC77D,if::(eq::(${chgTone},3),#1F9AA0A6|#1F8E939B,#1F9AA0A6|#1F8E939B)))]",
        "paddingLeft": "8pt",
        "paddingRight": "8pt",
        "paddingTop": "4pt",
        "paddingBottom": "4pt",
        "cornerRadius": {
          "leftT": "11pt",
          "leftB": "11pt",
          "rightT": "11pt",
          "rightB": "11pt"
        }
      },
      {
        "type": "txt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "textColor": "#6B7280|#8E939B",
        "id": "delta",
        "x": "{pill.r}+8pt",
        "y": "84.5pt",
        "w": "{parent.w}-{pill.r}-20pt",
        "text": "$[findNotEmpty::(${delta},)]",
        "fontSize": "11pt"
      },
      {
        "type": "txt",
        "h": "-1",
        "maxLines": "2",
        "lineBreak": "0",
        "textColor": "#6B7280|#8E939B",
        "id": "note",
        "x": "12pt",
        "y": "118pt",
        "w": "134pt",
        "lineSpacing": "2pt",
        "text": "$[findNotEmpty::(${note},)]",
        "fontSize": "11pt"
      }
    ]
  }
}
