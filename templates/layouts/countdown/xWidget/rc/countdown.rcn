{
  "_note": "版式「倒数」· 22 档(158×158)。坐标与配色是版式的一部分,不要改;要换内容改 flow/countdown.df 的「① 槽位」。由版式生成器产出。",
  "rc": {
    "cells": [
      {
        "id": "bg",
        "type": "layer",
        "x": "0pt",
        "y": "0pt",
        "w": "{parent.w}",
        "h": "{parent.h}",
        "bgColor": "#FFFFFF|#15171A"
      },
      {
        "type": "txt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "textColor": "#0E1116|#F3F4F6",
        "id": "nm",
        "x": "21pt",
        "y": "11pt",
        "w": "{parent.w}-33pt",
        "text": "$[findNotEmpty::(${title},--)]",
        "fontSize": "13pt",
        "typeface": "System-Bold"
      },
      {
        "id": "dot",
        "type": "layer",
        "x": "12pt",
        "y": "{nm.y}+({nm.h}-5pt)/2",
        "w": "5pt",
        "h": "5pt",
        "bgColor": "$[if::(eq::(${accent},green),#2E9E6B|#45C793,if::(eq::(${accent},blue),#2F6FE4|#5C9BFF,if::(eq::(${accent},purple),#7A5AF8|#A78BFA,if::(eq::(${accent},orange),#E07B39|#F0A05F,if::(eq::(${accent},rose),#D2536D|#E87A93,if::(eq::(${accent},teal),#0E9AA7|#35C2CE,if::(eq::(${accent},graphite),#8A9099|#6E747D,#5B5BD6|#A5A3FF)))))))]",
        "cornerRadius": {
          "leftT": "2.5pt",
          "leftB": "2.5pt",
          "rightT": "2.5pt",
          "rightB": "2.5pt"
        }
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${state},today),0,1)]"
        },
        "react": [
          {
            "type": "txt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "textColor": "#6B7280|#8E939B",
            "id": "pre",
            "x": "12pt",
            "y": "38pt",
            "w": "134pt",
            "text": "$[findNotEmpty::(${pre},)]",
            "fontSize": "12pt"
          },
          {
            "id": "num",
            "type": "richText",
            "x": "12pt",
            "y": "60.1pt",
            "w": "134pt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "spans": [
              {
                "text": "$[findNotEmpty::(${daysS},--)]",
                "fontSize": "44pt",
                "typeface": "System-Bold",
                "textColor": "#0E1116|#F3F4F6"
              },
              {
                "text": "${@i18n.nbsp}",
                "fontSize": "11pt"
              },
              {
                "text": "$[findNotEmpty::(${unitS},)]",
                "fontSize": "13pt",
                "textColor": "#6B7280|#8E939B"
              }
            ]
          }
        ]
      },
      {
        "type": "op",
        "action": "if",
        "props": {
          "val": "$[if::(eq::(${state},today),1,0)]"
        },
        "react": [
          {
            "type": "txt",
            "h": "-1",
            "maxLines": "1",
            "lineBreak": "0",
            "textColor": "$[if::(eq::(${accent},green),#2E9E6B|#45C793,if::(eq::(${accent},blue),#2F6FE4|#5C9BFF,if::(eq::(${accent},purple),#7A5AF8|#A78BFA,if::(eq::(${accent},orange),#E07B39|#F0A05F,if::(eq::(${accent},rose),#D2536D|#E87A93,if::(eq::(${accent},teal),#0E9AA7|#35C2CE,if::(eq::(${accent},graphite),#8A9099|#6E747D,#5B5BD6|#A5A3FF)))))))]",
            "id": "today",
            "x": "12pt",
            "y": "54pt",
            "w": "134pt",
            "text": "${@i18n.t_today}",
            "fontSize": "28pt",
            "typeface": "System-Bold"
          }
        ]
      },
      {
        "type": "txt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "textColor": "#0E1116|#F3F4F6",
        "id": "note",
        "x": "12pt",
        "y": "106pt",
        "w": "134pt",
        "text": "$[findNotEmpty::(${note},)]",
        "fontSize": "12pt"
      },
      {
        "type": "txt",
        "h": "-1",
        "maxLines": "1",
        "lineBreak": "0",
        "textColor": "#6B7280|#8E939B",
        "id": "date",
        "x": "12pt",
        "y": "127pt",
        "w": "134pt",
        "text": "$[findNotEmpty::(${dateS},)]",
        "fontSize": "11pt"
      }
    ],
    "i18n": {
      "zh-CN": {
        "nbsp": " ",
        "t_today": "就是今天"
      },
      "en-US": {
        "nbsp": " ",
        "t_today": "Today"
      }
    }
  }
}
