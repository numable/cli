{
  "version": 2,
  "title": "对比",
  "sub": "版式 · 4×2",
  "i18n": {
    "en-US": {
      "title": "Compare",
      "sub": "Layout · 4×2"
    }
  },
  "layout": 42,
  "params": {},
  "ai": {
    "shows": "同一个量在 2–3 个对象之间并排比,最大的那个用源色标出"
  },
  "events": {
    "onClick": "numable://self"
  },
  "canvas": {
    "source": "@[file://rc/compare.rcn]",
    "depends": [
      {
        "flow": "@[file://flow/compare.df]",
        "params": {}
      }
    ],
    "refresh": {
      "interval": [
        "300"
      ]
    }
  }
}
