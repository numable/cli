{
  "version": 1,
  "id": "__ID__",
  "title": "每日提醒",
  "sub": "到点提醒你做一件事",
  "_note": "静态提醒 = 有 alert、task 里没有 depends。发什么、什么时候发,在用户创建那一刻就全定死了,交给系统定时,应用没开也会响。",
  "_note_minEngine": "发布前把 manifest.minEngine 抬到当前引擎版本 —— numable check 的 G45 会直接告诉你现在是几。写低了的话,装在旧版应用上这条提醒只是不响,不报错。",
  "i18n": {
    "en-US": {
      "title": "Daily reminder",
      "sub": "A nudge at the time you pick",
      "message": { "title": "Time for ${what}", "body": "You set this for ${time}" },
      "form": { "what": { "title": "Remind me to" }, "time": { "title": "Time" } }
    }
  },
  "params": { "time": "08:00", "what": "" },
  "form": {
    "what": {
      "title": "提醒我做什么",
      "required": true,
      "component": { "type": "textInput" }
    },
    "time": { "title": "时间", "component": { "type": "timePicker" } }
  },
  "events": { "onClick": "numable://self" },
  "task": {
    "_note": "at 是每天的时点。只有没有 depends 的静态提醒才允许在这里写 ${参数};要只在工作日响,就在 refresh 里加 days,值是 mon tue wed thu fri 这样的星期缩写数组。",
    "refresh": { "at": ["${time}"] }
  },
  "alert": {
    "level": "normal",
    "_note": "没有 depends 时,message 只能引用 params 与 @app —— 创建那一刻别的键根本不存在,写了渲出来是空。",
    "message": { "title": "该 ${what} 了", "body": "你把它定在 ${time}" }
  }
}
