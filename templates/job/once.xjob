{
  "version": 1,
  "id": "__ID__",
  "title": "到时提醒我",
  "sub": "选一个日期和时间,到点只响一次",
  "_note": "一次性提醒 = 静态提醒的 at 写成日期式「YYYY-MM-DD HH:MM」。创建那一刻整条就交给系统定时,一个月后的也现在就排上,应用没开也会响;响过之后管理页这一行写「已结束」,过 7 天自动清掉。",
  "_note_minEngine": "日期式 at 要求 manifest.minEngine 至少 3 —— 旧版应用读不懂日期式,那一项会被静默丢掉:装得上、就是不响。numable check 的 G45.min-engine 会拦。",
  "i18n": {
    "en-US": {
      "title": "Remind me then",
      "sub": "Pick a date and time; it fires once",
      "message": { "title": "${what}", "body": "Set for ${date} ${time}" },
      "form": { "what": { "title": "Remind me to" }, "date": { "title": "Date" }, "time": { "title": "Time" } }
    }
  },
  "params": { "what": "", "date": "", "time": "09:00" },
  "form": {
    "what": {
      "title": "提醒我做什么",
      "required": true,
      "component": { "type": "textInput" }
    },
    "date": { "title": "日期", "component": { "type": "datePicker", "props": { "format": "YYYY-MM-DD" } } },
    "time": { "title": "时间", "component": { "type": "timePicker" } }
  },
  "events": { "onClick": "numable://self" },
  "task": {
    "_note": "at 的项中间有空格就是日期式,只响一次;时刻按设备当地时间解释,要钉死某个时区(比如「纽约时间 8:30 公布」)就在 refresh 里加 tz。日期没选(date 为空)时这一项作废、不会退化成每天响,同意面板的主按钮会置灰;选了一个已经过去的时刻也一样。不能再写 interval / days,也不能与每日式 HH:MM 混写(G45.once)。",
    "refresh": { "at": ["${date} ${time}"] }
  },
  "alert": {
    "level": "normal",
    "_note": "没有 depends 时,message 只能引用 params 与 @app。包想在事情办完后撤掉这条提醒,在 .af 里调 alert.remove { id, params: { 你的业务键 } } —— params 按子集匹配,给出的键相等就删。",
    "message": { "title": "${what}", "body": "你定在 ${date} ${time}" }
  }
}
